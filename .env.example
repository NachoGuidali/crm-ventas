# ── Django ────────────────────────────────────────────────
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=crm.midominio.com localhost
CSRF_TRUSTED_ORIGINS=https://crm.midominio.com
# URL pública (links de emails, webhooks, media para Meta/Twilio)
SITE_URL=https://crm.midominio.com
CRM_NOMBRE=CRM Ventas
CRM_SUBTITULO=SupReg Solutions
# Si todavía no hay HTTPS, poner False
SECURE_COOKIES=True

# ── Usuario administrador inicial (solo se crea si no existe ninguno) ──
ADMIN_USERNAME=admin
ADMIN_EMAIL=sistemas@midominio.com
ADMIN_PASSWORD=

# ── Base de datos / Redis ────────────────────────────────
POSTGRES_DB=crm_ventas
POSTGRES_USER=crm_ventas
POSTGRES_PASSWORD=cambiar
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# ── Capacidad ────────────────────────────────────────────
WEB_WORKERS=4
WORKER_CONCURRENCY=4
WORKER_MASIVOS_CONCURRENCY=3

# ── Email (recupero de contraseña y mensajes automáticos) ─
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CRM Ventas <no-responder@midominio.com>

# ── WhatsApp: valores por defecto para líneas Evolution ──
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=cambiar
EVOLUTION_SERVER_URL=https://evolution.midominio.com

# ── API externa global (opcional; mejor usar claves por integración desde el panel) ──
CRM_API_KEY=
LOG_RETENTION_DAYS=90
